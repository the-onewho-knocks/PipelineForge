{
  "uid": "pipelineforge",
  "title": "PipelineForge – GitHub Trending Pipeline",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "type": "stat",
      "title": "Messages Consumed",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "pipelineforge_worker_messages_consumed_total",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "DB Inserts",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "pipelineforge_postgres_inserts_total",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "DB Errors",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "pipelineforge_postgres_errors_total",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Messages Processed / sec",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "rate(pipelineforge_worker_messages_consumed_total[1m])",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "DB Insert Rate",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "rate(pipelineforge_postgres_inserts_total[1m])",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Message Processing Latency (p95)",
      "gridPos": { "x": 0, "y": 10, "w": 24, "h": 6 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(pipelineforge_worker_message_processing_seconds_bucket[1m]))",
          "refId": "A"
        }
      ]
    }
  ]
}
